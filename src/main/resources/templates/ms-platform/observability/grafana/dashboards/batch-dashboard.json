{
  "title": "Batch Dashboard",
  "uid": "batch-dashboard",
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 2,
  "refresh": "10s",
  "tags": [
    "batch",
    "loki",
    "service-batch"
  ],
  "templating": {
    "list": [
      {
        "name": "jobId",
        "type": "textbox",
        "label": "Job ID",
        "query": "",
        "current": {
          "text": "",
          "value": ""
        }
      },
      {
        "name": "container",
        "type": "query",
        "label": "Instance / container",
        "datasource": {
          "type": "loki",
          "uid": "Loki"
        },
        "query": "label_values({service=\"service-batch\"}, container)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "current": {
          "text": "All",
          "value": "$__all"
        }
      }
    ]
  },
  "panels": [
    {
      "type": "logs",
      "title": "Batch completed",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 7
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "Loki"
          },
          "expr": "{service=\"service-batch\", container=~\"$container\"} |= \"BATCH_COMPLETED\"",
          "refId": "A"
        }
      ],
      "options": {
        "showTime": true,
        "wrapLogMessage": true
      }
    },
    {
      "type": "logs",
      "title": "Batch failed",
      "gridPos": {
        "x": 0,
        "y": 7,
        "w": 24,
        "h": 7
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "Loki"
          },
          "expr": "{service=\"service-batch\", container=~\"$container\"} |= \"BATCH_FAILED\"",
          "refId": "A"
        }
      ],
      "options": {
        "showTime": true,
        "wrapLogMessage": true
      }
    },
    {
      "type": "logs",
      "title": "Search by jobId",
      "gridPos": {
        "x": 0,
        "y": 14,
        "w": 24,
        "h": 7
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "Loki"
          },
          "expr": "{service=\"service-batch\"} |= \"$jobId\"",
          "refId": "A"
        }
      ],
      "options": {
        "showTime": true,
        "wrapLogMessage": true
      }
    },
    {
      "type": "logs",
      "title": "All service-batch logs by selected instance",
      "gridPos": {
        "x": 0,
        "y": 21,
        "w": 24,
        "h": 7
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "Loki"
          },
          "expr": "{service=\"service-batch\", container=~\"$container\"}",
          "refId": "A"
        }
      ],
      "options": {
        "showTime": true,
        "wrapLogMessage": true
      }
    }
  ]
}